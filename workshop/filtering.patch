diff --git a/tests/test_filtering.py b/tests/test_filtering.py
new file mode 100644
--- /dev/null
+++ b/tests/test_filtering.py
@@ -0,0 +1,129 @@
+import re
+from urllib.parse import urlencode
+
+import pytest
+from flask.testing import FlaskClient
+
+EXPECTED_PAIRS = [
+    ("engineering", "pending", [1]),
+    ("engineering", "approved", [5]),
+    ("engineering", "rejected", [9]),
+    ("sales", "pending", [6]),
+    ("sales", "approved", [2]),
+    ("sales", "rejected", [10]),
+    ("corporate", "pending", [11, 3]),
+    ("corporate", "approved", [7]),
+    ("corporate", "rejected", []),
+    ("design", "pending", [8]),
+    ("design", "approved", [12]),
+    ("design", "rejected", [4]),
+]
+
+
+def assert_listing(client: FlaskClient, parameters: dict[str, str], expected: list[int]) -> None:
+    query = urlencode(parameters)
+    api = client.get(f"/api/requests?{query}")
+    assert api.status_code == 200
+    payload = api.get_json()
+    assert payload["count"] == len(payload["items"]) == len(expected)
+    assert [item["id"] for item in payload["items"]] == expected
+    response = client.get(f"/requests?{query}")
+    assert response.status_code == 200
+    page = response.get_data(as_text=True)
+    assert f"{len(expected)}件を表示" in page
+    assert [int(value) for value in re.findall(r"#(\d+) ·", page)] == expected
+    for item in payload["items"]:
+        assert item["title"] in page
+
+
+@pytest.mark.parametrize(("department", "status", "expected"), EXPECTED_PAIRS)
+def test_combined_filters_use_and_in_ui_and_api(
+    client: FlaskClient,
+    department: str,
+    status: str,
+    expected: list[int],
+) -> None:
+    assert_listing(client, {"department": department, "status": status}, expected)
+
+
+@pytest.mark.parametrize(
+    ("parameters", "expected"),
+    [
+        ({}, list(range(12, 0, -1))),
+        ({"department": "", "status": ""}, list(range(12, 0, -1))),
+        ({"department": "engineering"}, [9, 5, 1]),
+        ({"department": "sales"}, [10, 6, 2]),
+        ({"department": "corporate"}, [11, 7, 3]),
+        ({"department": "design"}, [12, 8, 4]),
+        ({"status": "pending"}, [11, 8, 6, 3, 1]),
+        ({"status": "approved"}, [12, 7, 5, 2]),
+        ({"status": "rejected"}, [10, 9, 4]),
+        ({"department": "", "status": "approved"}, [12, 7, 5, 2]),
+        ({"department": "engineering", "status": ""}, [9, 5, 1]),
+        ({"department": "engineering", "status": "pending", "scoutTheme": "dark"}, [1]),
+    ],
+)
+def test_single_empty_and_theme_conditions(
+    client: FlaskClient,
+    parameters: dict[str, str],
+    expected: list[int],
+) -> None:
+    assert_listing(client, parameters, expected)
+
+
+def test_selected_conditions_and_global_summary_remain_visible(client: FlaskClient) -> None:
+    response = client.get("/requests?department=engineering&status=pending")
+    page = response.get_data(as_text=True)
+    assert re.search(r'<option value="engineering"\s+selected>', page)
+    assert re.search(r'<option value="pending"\s+selected>', page)
+    assert [int(value) for value in re.findall(r"<strong>(\d+)<small>件", page)] == [12, 5, 4, 3]
+    assert 'href="/requests">条件を解除</a>' in page
+
+
+def test_no_matches_has_explanation_and_clear_action(client: FlaskClient) -> None:
+    response = client.get("/requests?department=corporate&status=rejected")
+    assert response.status_code == 200
+    page = response.get_data(as_text=True)
+    assert "0件を表示" in page
+    assert "指定した条件に一致する申請はありません" in page
+    assert "条件を解除する" in page
+    assert "まだ申請が登録されていません" not in page
+    assert client.get("/api/requests?department=corporate&status=rejected").get_json() == {
+        "items": [],
+        "count": 0,
+    }
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "department=unknown",
+        "status=unknown",
+        "status=Pending",
+        "department=engineering&department=sales",
+        "status=pending&status=approved",
+        "department=&department=engineering",
+        "status=&status=",
+        "department=engineering&unexpected=x",
+        "department=engineering%27%20OR%201%3D1--",
+        "status=%3Cscript%3E",
+        "department=%20engineering",
+        "status=0",
+    ],
+)
+@pytest.mark.parametrize("path", ["/requests", "/api/requests"])
+def test_invalid_filters_return_400_without_changing_data(
+    client: FlaskClient,
+    path: str,
+    query: str,
+) -> None:
+    response = client.get(f"{path}?{query}")
+    assert response.status_code == 400
+    if path.startswith("/api/"):
+        error = response.get_json()["error"]
+        assert error["code"] == 400
+        assert error["message"]
+        assert "items" not in response.get_json()
+    else:
+        assert 'role="alert"' in response.get_data(as_text=True)
+    assert client.get("/api/requests").get_json()["count"] == 12
